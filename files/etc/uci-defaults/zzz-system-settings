#!/bin/sh

# 修改基本设置
uci set system.@system[0].hostname='OpenWrt-GXNAS'
uci set system.@system[0].zonename='Asia/Shanghai'
uci set system.@system[0].timezone='CST-8'
uci -q delete system.ntp.server
uci add_list system.ntp.server='ntp.aliyun.com'
uci add_list system.ntp.server='time1.cloud.tencent.com'
uci add_list system.ntp.server='time.apple.com'
uci add_list system.ntp.server='time.windows.com'
uci commit system

# LuCI 默认语言
uci -q set luci.main.lang='zh_cn'
uci -q commit luci

# iStore 前端语言（UCI）
uci -q set istore.istore.istore_vue_lang='zh-cn'
uci -q commit istore

# ========== 强制 iStore 前端显示中文（增强版 + 日志） ==========
if [ -f /www/luci-static/istore/i18n/zh-cn.json ]; then
    echo "$(date) - Forcing iStore Chinese..." >> /tmp/zzz-istore.log
    sed 's/"zh-cn":/"en":/' /www/luci-static/istore/i18n/zh-cn.json > /tmp/en-forced.json 2>> /tmp/zzz-istore.log
    if [ -s /tmp/en-forced.json ]; then
        cp -f /tmp/en-forced.json /www/luci-static/istore/i18n/en.json 2>> /tmp/zzz-istore.log
        echo "$(date) - iStore en.json forced successfully" >> /tmp/zzz-istore.log
        ls -l /www/luci-static/istore/i18n/en.json >> /tmp/zzz-istore.log
    else
        echo "$(date) - sed failed, en-forced.json empty or missing" >> /tmp/zzz-istore.log
    fi
else
    echo "$(date) - zh-cn.json not found" >> /tmp/zzz-istore.log
fi

# ========== Netdata 强制启用 ==========
[ -f /etc/config/netdata ] || touch /etc/config/netdata
uci -q batch <<EOF
set netdata.netdata=netdata
set netdata.netdata.enabled='1'
set netdata.netdata.port='19999'
commit netdata
EOF

[ -f /etc/init.d/netdata ] && {
    chmod +x /etc/init.d/netdata
    /etc/init.d/netdata enable
    /etc/init.d/netdata start
}

# TurboACC 默认启用 BBR
if [ -f /etc/config/turboacc ]; then
    uci -q set turboacc.config.tcpcca='bbr'
    uci -q commit turboacc
    /etc/init.d/turboacc restart >/dev/null 2>&1
fi

exit 0
